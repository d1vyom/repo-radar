# Optional for public GitHub reads; a valid token increases the rate limit.
GITHUB_TOKEN=

# Supabase catalog and daily analytics (server-side).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Generate a random secret for authenticated scheduled synchronization.
CRON_SECRET=replace_with_a_random_secret

# Optional canonical URL for sitemap and robots.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
